# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Local:      run `npx supabase status` and copy "API URL" and "Publishable key".
# Production: Supabase dashboard -> Project Settings -> API Keys (publishable key, sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
